#!/bin/sh

if [ -r /etc/TZ ]; then
	TZ=$(cat /etc/TZ)
	export TZ
fi
DAEMON="majestic"
DAEMON_PATH="/usr/bin/$DAEMON"
DAEMON_ARGS="-s"

running() {
	start-stop-daemon -t -K -q -x "$DAEMON_PATH"
}

start() {
	printf 'Starting %s: ' "$DAEMON"
	(
		# Survive an SSH disconnect during daemon startup.
		trap '' HUP
		[ ! -r /etc/default/majestic ] || . /etc/default/majestic
		start-stop-daemon -b -S -q -x "$DAEMON_PATH" -a "$DAEMON" -- $DAEMON_ARGS
	)
	case $? in
		0) echo "OK" ;;
		1) echo "OK (already running)" ;;
		*) echo "FAIL"; return 1 ;;
	esac
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	# Match the executable, not a stale or recycled PID file.
	start-stop-daemon -K -q -x "$DAEMON_PATH"
	i=0
	while running && [ "$i" -lt 10 ]; do
		i=$((i + 1))
		sleep 1
	done
	if running; then
		echo "FAIL"
		return 1
	fi
	rm -f "/var/run/$DAEMON.pid"
	echo "OK"
}

case "$1" in
	start|stop)
		$1
		;;

	restart)
		stop || exit 1
		sleep 3
		start
		;;

	reload)
		start-stop-daemon -K -s 1 -q -x "$DAEMON_PATH"
		;;

	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
